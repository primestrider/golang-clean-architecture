# Mode lengkap: semua fitur opsional aktif dan diarahkan ke service di
# docker-compose (profil "full"). Hanya untuk pengembangan lokal.
APP_APP_ENV=development
APP_DOCS_ENABLED=true
APP_LOG_FORMAT=json
APP_LOG_LEVEL=info

APP_KAFKA_ENABLED=true
APP_KAFKA_BROKERS=kafka:9092

APP_REDIS_ENABLED=true
APP_REDIS_ADDR=redis:6379

APP_STORAGE_ENABLED=true
APP_STORAGE_ENDPOINT=s3:8333
APP_STORAGE_PUBLIC_ENDPOINT=localhost:8333
APP_STORAGE_ACCESS_KEY=devaccesskey
APP_STORAGE_SECRET_KEY=devsecretkey
APP_STORAGE_BUCKET=avatars

APP_EMAIL_ENABLED=true
APP_EMAIL_HOST=mailpit
APP_EMAIL_PORT=1025

APP_OTEL_ENABLED=true
APP_OTEL_ENDPOINT=jaeger:4317
# Jaeger lokal tidak memakai TLS.
APP_OTEL_INSECURE=true

APP_GRPC_ENABLED=true
