# Salin menjadi .env lalu isi. Setiap key config.json bisa ditimpa dengan
# format APP_<SECTION>_<KEY> (titik diganti garis bawah, huruf besar).
# Secret hanya boleh diisi lewat env, jangan di config.json.

APP_APP_ENV=development
APP_DATABASE_PASSWORD=
# Wajib >= 32 byte di production. Buat dengan: openssl rand -base64 48
APP_JWT_SECRET=

APP_KAFKA_ENABLED=false
APP_REDIS_ENABLED=false
APP_STORAGE_ENABLED=false
APP_STORAGE_ACCESS_KEY=
APP_STORAGE_SECRET_KEY=
APP_EMAIL_ENABLED=false
APP_EMAIL_PASSWORD=
APP_OTEL_ENABLED=false
